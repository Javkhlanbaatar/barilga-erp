# PostgreSQL
DATABASE_URL=postgresql://barilga:barilga@localhost:5432/barilga_erp?schema=public

# API
API_PORT=4000
API_PREFIX=api
JWT_SECRET=change-me-in-production-use-64-random-bytes
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# QPay v2 (leave blank to run in mock/sandbox mode)
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4000/api/payment/qpay/webhook
QPAY_MOCK=true

# E-Barimt POSAPI (mock sandbox when EBARIMT_MOCK=true)
EBARIMT_MOCK=true
EBARIMT_POSAPI_URL=http://localhost:7080
EBARIMT_MERCHANT_TIN=0000000
EBARIMT_BRANCH_NO=001
EBARIMT_POS_NO=10000001
EBARIMT_DISTRICT_CODE=24

# Public endpoints / payment window
# Number of reverse-proxy hops in front of the API (1 behind nginx). Leave empty for local dev.
# Rate limits use the client IP, so this MUST be set behind a proxy.
TRUST_PROXY=
# Cancel orders still unpaid after N minutes. Empty/0 = never expire (business decision pending).
ORDER_PAYMENT_TTL_MINUTES=
# Max unpaid web orders per phone number
PUBLIC_MAX_OPEN_ORDERS_PER_PHONE=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=3000
