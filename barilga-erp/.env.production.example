# Copy to .env.production on the VPS. Never commit the real file.
#   cp .env.production.example .env.production

POSTGRES_USER=barilga
POSTGRES_PASSWORD=replace-with-64-char-random
POSTGRES_DB=barilga_erp

JWT_SECRET=replace-with-64-char-random
JWT_EXPIRES_IN=12h

# Public origin (no trailing slash). Used for CORS and browser API calls.
CORS_ORIGIN=https://erp.example.com
NEXT_PUBLIC_API_URL=https://erp.example.com/api

NODE_ENV=production
API_PREFIX=api

QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=https://erp.example.com/api/payment/qpay/webhook
QPAY_MOCK=false

# One reverse proxy (nginx) in front of the API: needed for per-IP rate limiting.
TRUST_PROXY=1
# Cancel orders still unpaid after N minutes. Empty/0 = never expire (business decision pending).
ORDER_PAYMENT_TTL_MINUTES=
PUBLIC_MAX_OPEN_ORDERS_PER_PHONE=5

EBARIMT_MOCK=false
EBARIMT_POSAPI_URL=http://ebarimt-posapi:7080
EBARIMT_MERCHANT_TIN=
EBARIMT_BRANCH_NO=001
EBARIMT_POS_NO=10000001
EBARIMT_DISTRICT_CODE=24
